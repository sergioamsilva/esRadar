---
/**
 * Mapa das colocações: um ponto por estabelecimento do CNA, área
 * proporcional aos colocados na 1ª fase, cor pelo subsistema.
 *
 * Os traçados dos distritos vêm de data/mapa/continente.json (herdados do
 * snsRadar, já projetados num espaço de 340×560); os pontos usam a MESMA
 * projeção equirretangular com a longitude corrigida por cos(lat média) —
 * tem de ser exatamente esta, senão os pontos não caem no desenho.
 *
 * As coordenadas dos estabelecimentos foram extraídas dos links «Mapa» das
 * páginas do guia da DGES. Açores e Madeira ficam fora do retângulo do
 * continente e são contados à parte na legenda.
 */
import fs from "node:fs";
import path from "node:path";
import { ligacaoInstituicao, formatarInteiro, type Instituicao } from "../lib/dados";

interface Props {
  instituicoes: Instituicao[];
  /** Ativa a vista coroplética alternável (ocupação por distrito). */
  alternavel?: boolean;
}
const { instituicoes, alternavel = false } = Astro.props;

/* Ocupação por distrito, para a camada coroplética. */
const porDistrito = new Map<string, { vagas: number; colocados: number }>();
for (const i of instituicoes) {
  if (!i.distrito) continue;
  const d = porDistrito.get(i.distrito) ?? { vagas: 0, colocados: 0 };
  d.vagas += i.vagas;
  d.colocados += i.colocados_f1;
  porDistrito.set(i.distrito, d);
}
const ocupacaoDe = (nome: string) => {
  const d = porDistrito.get(nome);
  return d && d.vagas ? d.colocados / d.vagas : null;
};

const mapa: { w: number; h: number; paths: { n: string; d: string }[] } = JSON.parse(
  fs.readFileSync(path.resolve(process.cwd(), "..", "data", "mapa", "continente.json"), "utf8"),
);

const LON0 = -9.6, LON1 = -6.15, LAT0 = 36.9, LAT1 = 42.2;
const X0 = 6, Y0 = 6;
const k = Math.cos((((LAT0 + LAT1) / 2) * Math.PI) / 180);
const escala = Math.min((mapa.w - 2 * X0) / ((LON1 - LON0) * k), (mapa.h - 2 * Y0) / (LAT1 - LAT0));
const projetar = (g: { lat: number; lon: number }) => ({
  x: X0 + (g.lon - LON0) * k * escala,
  y: Y0 + (LAT1 - g.lat) * escala,
});

const comGeo = instituicoes.filter((i) => i.geo);
const continente = comGeo.filter(
  (i) => i.geo!.lon >= LON0 && i.geo!.lon <= LON1 && i.geo!.lat >= LAT0 && i.geo!.lat <= LAT1,
);
const ilhas = comGeo.filter((i) => !continente.includes(i));
const ilhasColocados = ilhas.reduce((s, i) => s + i.colocados_f1, 0);

const maxColocados = Math.max(...continente.map((i) => i.colocados_f1), 1);
const R_MAX = 15;
const raio = (c: number) => Math.max(2.2, R_MAX * Math.sqrt(c / maxColocados));

const pontos = continente
  .map((i) => ({ ...i, ...projetar(i.geo!), r: raio(i.colocados_f1) }))
  .sort((a, b) => b.r - a.r);
---

<figure class="mapa reveal">
  {/* Sem role="img" no svg: os pontos são links, e filhos de uma «imagem»
      não podem ser interativos (axe: nested-interactive). A descrição vive
      no aria-label de cada link e na legenda. */}
  {
    alternavel && (
      <div class="mapa__modos js-so" hidden data-mapa-modos role="group" aria-label="Modo do mapa">
        <button type="button" class="chip mapa__modo on" data-mapa-modo="pontos">Estabelecimentos</button>
        <button type="button" class="chip mapa__modo" data-mapa-modo="coro">Ocupação por distrito</button>
      </div>
    )
  }
  <div class="mapa__zoom js-so" hidden data-mapa-zoom role="group" aria-label="Zoom do mapa">
    <button type="button" class="chip" data-zoom-mais aria-label="Aproximar">+</button>
    <button type="button" class="chip" data-zoom-menos aria-label="Afastar">−</button>
    <button type="button" class="chip" data-zoom-repor aria-label="Repor vista">⌂</button>
  </div>
  <svg viewBox={`0 0 ${mapa.w} ${mapa.h}`} data-mapa-svg aria-label="Mapa de Portugal continental">
    {
      mapa.paths.map((p) => {
        const oc = ocupacaoDe(p.n);
        const d = porDistrito.get(p.n);
        return (
          <path
            d={p.d}
            class="mapa__distrito"
            style={oc != null ? `--fc:color-mix(in srgb, var(--serie-1) ${Math.round(8 + oc * 84)}%, var(--surface))` : undefined}
            data-dica={
              d
                ? `${p.n}: ${Math.round((oc ?? 0) * 100)}% das vagas preenchidas — ${formatarInteiro(d.colocados)} colocados em ${formatarInteiro(d.vagas)} vagas`
                : `${p.n}: sem estabelecimentos no concurso`
            }
          />
        );
      })
    }
    {
      pontos.map((p, i) => (
        <a
          href={ligacaoInstituicao(p)}
          aria-label={`${p.nome} — ${formatarInteiro(p.colocados_f1)} colocados em ${formatarInteiro(p.vagas)} vagas`}
        >
          <circle
            cx={p.x.toFixed(1)}
            cy={p.y.toFixed(1)}
            r={p.r.toFixed(1)}
            class={`mapa__ponto mapa__ponto--${p.subsistema ?? "universitario"} ponto-vem`}
            style={`--dp:${0.15 + (i % 24) * 0.045}s`}
            data-dica={`${p.nome}\n${formatarInteiro(p.colocados_f1)} colocados em ${formatarInteiro(p.vagas)} vagas${p.sobras_f1 ? ` · ${formatarInteiro(p.sobras_f1)} sobras` : ""}`}
          >
            <title>
              {`${p.nome} — ${formatarInteiro(p.colocados_f1)} colocados, ${formatarInteiro(p.vagas)} vagas${p.sobras_f1 ? `, ${formatarInteiro(p.sobras_f1)} sobras` : ""}`}
            </title>
          </circle>
        </a>
      ))
    }
  </svg>
  <figcaption class="mapa__legenda">
    <span class="mapa__chave">
      <span class="mapa__amostra mapa__amostra--universitario" aria-hidden="true"></span>
      universitário
    </span>
    <span class="mapa__chave">
      <span class="mapa__amostra mapa__amostra--politecnico" aria-hidden="true"></span>
      politécnico
    </span>
    <span class="mapa__nota">
      área ∝ colocados na 1ª fase de 2026
      {
        ilhas.length > 0 &&
          ` · + ${ilhas.length} estabelecimentos nos Açores e Madeira (${formatarInteiro(ilhasColocados)} colocados)`
      }
    </span>
  </figcaption>
</figure>

<script>
  const armarZoom = () => {
    document.querySelectorAll<SVGSVGElement>("[data-mapa-svg]:not([data-zoom-armado])").forEach((svg) => {
      svg.dataset.zoomArmado = "1";
      const figura = svg.closest("figure")!;
      const controlos = figura.querySelector<HTMLElement>("[data-mapa-zoom]");
      if (controlos) controlos.hidden = false;
      const base = svg.viewBox.baseVal;
      const inicial = { x: base.x, y: base.y, w: base.width, h: base.height };
      const aplicar = (v: { x: number; y: number; w: number; h: number }) => {
        let escala = inicial.w / v.w;
        // nunca afastar além da vista inicial nem aproximar mais de 14×
        if (escala < 1) {
          v = { ...inicial };
          escala = 1;
        }
        if (escala > 14) return;
        svg.setAttribute("viewBox", `${v.x} ${v.y} ${v.w} ${v.h}`);
        svg.classList.toggle("mapa--zoomed", escala > 1);
        // Os raios estão em unidades do viewBox: sem compensação, os pontos
        // crescem com o zoom e o aglomerado de Lisboa nunca se separa.
        // Compensar mantém cada ponto com o mesmo tamanho no ecrã enquanto
        // as distâncias entre centros crescem — é isso que os desagrega.
        svg.querySelectorAll<SVGCircleElement>("circle").forEach((c) => {
          const base = c.dataset.r ?? (c.dataset.r = c.getAttribute("r") ?? "2");
          // Compensação parcial: as distâncias crescem com o zoom completo,
          // os pontos só com escala^0.4 — separam-se sem encolher ao ponto
          // de não se conseguirem clicar.
          const r = Math.max(Number(base), 3) / Math.pow(escala, 0.6);
          c.setAttribute("r", r.toFixed(3));
        });
      };
      const atual = () => {
        const b = svg.viewBox.baseVal;
        return { x: b.x, y: b.y, w: b.width, h: b.height };
      };
      const zoom = (fator: number, cx?: number, cy?: number) => {
        const v = atual();
        const r = svg.getBoundingClientRect();
        const px = cx != null ? (cx - r.left) / r.width : 0.5;
        const py = cy != null ? (cy - r.top) / r.height : 0.5;
        const w = v.w / fator;
        const h = v.h / fator;
        aplicar({ x: v.x + (v.w - w) * px, y: v.y + (v.h - h) * py, w, h });
      };
      svg.addEventListener("wheel", (e) => {
        e.preventDefault();
        zoom(e.deltaY < 0 ? 1.25 : 1 / 1.25, e.clientX, e.clientY);
      }, { passive: false });
      controlos?.querySelector("[data-zoom-mais]")?.addEventListener("click", () => zoom(1.4));
      controlos?.querySelector("[data-zoom-menos]")?.addEventListener("click", () => zoom(1 / 1.4));
      controlos?.querySelector("[data-zoom-repor]")?.addEventListener("click", () => aplicar({ ...inicial }));
      // arrastar para navegar quando aproximado
      let arrasto: { x: number; y: number } | null = null;
      svg.addEventListener("pointerdown", (e) => {
        if (svg.viewBox.baseVal.width >= inicial.w) return;
        arrasto = { x: e.clientX, y: e.clientY };
        svg.setPointerCapture(e.pointerId);
      });
      svg.addEventListener("pointermove", (e) => {
        if (!arrasto) return;
        const v = atual();
        const r = svg.getBoundingClientRect();
        aplicar({
          x: v.x - ((e.clientX - arrasto.x) / r.width) * v.w,
          y: v.y - ((e.clientY - arrasto.y) / r.height) * v.h,
          w: v.w,
          h: v.h,
        });
        arrasto = { x: e.clientX, y: e.clientY };
      });
      svg.addEventListener("pointerup", () => (arrasto = null));
    });
  };
  armarZoom();
  document.addEventListener("astro:page-load", armarZoom);

  const armarMapa = () => {
    document.querySelectorAll<HTMLElement>("[data-mapa-modos]:not([data-armado])").forEach((grupo) => {
      grupo.dataset.armado = "1";
      grupo.hidden = false;
      const figura = grupo.closest("figure")!;
      grupo.querySelectorAll<HTMLButtonElement>("[data-mapa-modo]").forEach((botao) =>
        botao.addEventListener("click", () => {
          figura.classList.toggle("mapa--coro", botao.dataset.mapaModo === "coro");
          grupo.querySelectorAll(".mapa__modo").forEach((b) => b.classList.toggle("on", b === botao));
        }),
      );
    });
  };
  armarMapa();
  document.addEventListener("astro:page-load", armarMapa);
</script>

<style>
  .mapa {
    margin: 0;
  }
  .mapa svg {
    display: block;
    width: min(100%, 420px);
    height: auto;
    margin-inline: auto;
  }
  .mapa__distrito {
    fill: color-mix(in srgb, var(--grid) 55%, var(--surface));
    stroke: var(--baseline);
    stroke-width: 0.6;
    transition: fill 0.45s ease;
  }
  .mapa--coro .mapa__distrito {
    fill: var(--fc, color-mix(in srgb, var(--grid) 55%, var(--surface)));
  }
  .mapa--coro .mapa__distrito:hover {
    filter: brightness(1.12);
  }
  .mapa__ponto,
  .mapa svg a {
    transition: opacity 0.35s ease;
  }
  .mapa--coro svg a {
    opacity: 0.12;
    pointer-events: none;
  }
  .mapa__zoom {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 3;
  }
  .mapa__zoom .chip {
    width: 32px;
    height: 32px;
    padding: 0;
    display: grid;
    place-items: center;
    font-size: 15px;
    cursor: pointer;
  }
  .mapa svg.mapa--zoomed {
    cursor: grab;
  }
  .mapa svg.mapa--zoomed:active {
    cursor: grabbing;
  }
  .mapa {
    position: relative;
  }
  .mapa__modos {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-bottom: 10px;
  }
  .mapa__modo.on {
    background: var(--chip-on);
    color: var(--chip-on-ink);
    border-color: var(--chip-on);
  }
  .mapa__ponto {
    fill-opacity: 0.72;
    stroke: var(--surface);
    stroke-width: 0.8;
    transition: fill-opacity 0.2s ease;
  }
  .mapa__ponto:hover {
    fill-opacity: 1;
  }
  .mapa__ponto--universitario {
    fill: var(--serie-1);
  }
  .mapa__ponto--politecnico {
    fill: var(--serie-2);
  }
  .mapa__legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    justify-content: center;
    margin-top: 10px;
    font-size: var(--t-xs);
    color: var(--ink-2);
  }
  .mapa__chave {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .mapa__amostra {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .mapa__amostra--universitario {
    background: var(--serie-1);
  }
  .mapa__amostra--politecnico {
    background: var(--serie-2);
  }
  .mapa__nota {
    color: var(--muted);
    flex-basis: 100%;
    text-align: center;
  }
</style>
