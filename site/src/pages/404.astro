---
import Base from "../layouts/Base.astro";
import { ligacao } from "../lib/dados";
---

<Base
  titulo="Página não encontrada"
  descricao="Esta página não existe — mas os 1170 cursos do concurso estão todos aqui."
>
  <section class="perdido">
    <p class="perdido__404" aria-hidden="true">404</p>
    <h1>Esta página não entrou em nenhuma fase.</h1>
    <p class="desc medida">
      O endereço pode ter mudado — os cursos e instituições passaram a ter o nome no URL.
      Use a pesquisa (tecla <b>/</b>) ou um destes caminhos:
    </p>
    <p class="perdido__ligacoes">
      <a class="chip" href={ligacao("/")}>Panorama</a>
      <a class="chip" href={ligacao("/cursos/")}>Todos os cursos</a>
      <a class="chip" href={ligacao("/areas/")}>Áreas</a>
      <a class="chip" href={ligacao("/instituicoes/")}>Instituições</a>
    </p>
  </section>
</Base>

<style>
  .perdido {
    padding: 48px 0 60px;
    text-align: center;
  }
  .perdido__404 {
    font-size: clamp(72px, 14vw, 140px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    margin: 0;
    background: linear-gradient(100deg, var(--serie-1), var(--serie-2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .perdido h1 {
    font-size: clamp(20px, 3.4vw, 30px);
    margin: 10px 0 8px;
  }
  .perdido .medida {
    margin-inline: auto;
  }
  .perdido__ligacoes {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 18px;
  }
</style>
