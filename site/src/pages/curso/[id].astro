---
import Base from "../../layouts/Base.astro";
import SerieAnual from "../../components/SerieAnual.astro";
import {
  pares,
  ligacao,
  ligacaoCurso,
  ligacaoInstituicao,
  idCurso,
  slug,
  formatarNota,
  formatarInteiro,
  serieAnual,
  type Par,
} from "../../lib/dados";

export function getStaticPaths() {
  return pares().map((p) => ({ params: { id: idCurso(p) }, props: { ficha: p } }));
}

const { ficha } = Astro.props as { ficha: Par };

const f1_2026 = ficha.series["2026f1"] ?? {};
const f1_2025 = ficha.series["2025f1"] ?? {};
const nota2026 = f1_2026.nota_ultimo ?? null;
const nota2025 = f1_2025.nota_ultimo ?? null;
const variacao = nota2026 != null && nota2025 != null ? nota2026 - nota2025 : null;

const procura = f1_2025.candidatos_1opcao ?? null;
const vagas2025 = f1_2025.vagas ?? null;
const racio = procura != null && vagas2025 ? procura / vagas2025 : null;

const notasF1 = serieAnual(ficha, "nota_ultimo", 1);
const notasF2 = serieAnual(ficha, "nota_ultimo", 2);
const candidatos = serieAnual(ficha, "candidatos", 1);
const candidatos1op = serieAnual(ficha, "candidatos_1opcao", 1);

/* Geometria da régua do palco: a mesma escala 90–200 de todo o portal. */
const MIN = 90;
const MAX = 200;
const pos = (v: number) => ((Math.max(MIN, Math.min(MAX, v)) - MIN) / (MAX - MIN)) * 100;
const eixos = [100, 120, 140, 160, 180, 200];

const info = ficha.infocursos;
const percentilEntrada = info?.percentil_entrada
  ? Object.entries(info.percentil_entrada)
      .map(([ano, v]) => ({ ano: Number(ano), valor: v.percentil }))
      .sort((a, b) => a.ano - b.ano)
  : [];
const sexo = info?.sexo;
const pctMulheres =
  sexo?.inscritos && sexo.mulheres != null ? Math.round((100 * sexo.mulheres) / sexo.inscritos) : null;
const umAno = info?.apos_1_ano;
const segmentosUmAno = umAno
  ? [
      { rotulo: "continuam no curso", valor: umAno.fica, classe: "fica" },
      { rotulo: "mudam de curso na mesma instituição", valor: umAno.muda_curso, classe: "muda-curso" },
      { rotulo: "mudam de instituição", valor: umAno.muda_estabelecimento, classe: "muda-inst" },
      { rotulo: "não se encontram no ensino superior", valor: umAno.fora, classe: "fora" },
    ].filter((s) => s.valor > 0)
  : [];

/* Provas de ingresso: o texto do guia vira conjuntos alternativos
   («06 Filosofia + 18 Português» ou …). Se a estrutura fugir ao padrão
   (pré-requisitos, texto livre), cai-se no texto tal e qual. */
type Prova = { cod: string; nome: string };
const parseProvas = (texto: string | null): { grupos: Prova[][]; escolha: boolean } | null => {
  if (!texto) return null;
  const linhas = texto.split("\n").map((l) => l.trim()).filter(Boolean);
  const escolha = /um dos seguintes/i.test(linhas[0] ?? "");
  if (escolha) linhas.shift();
  const grupos: Prova[][] = [[]];
  for (const linha of linhas) {
    if (/^ou$/i.test(linha)) {
      grupos.push([]);
      continue;
    }
    const m = linha.match(/^(\d{2})\s+(.+)$/);
    if (!m) return null;
    grupos[grupos.length - 1].push({ cod: m[1], nome: m[2] });
  }
  const limpos = grupos.filter((g) => g.length);
  return limpos.length ? { grupos: limpos, escolha: escolha || limpos.length > 1 } : null;
};
const provas = parseProvas(ficha.provas_ingresso);

const distritosPreferencia = ficha.preferencia_regional
  ? ficha.preferencia_regional.area_influencia.split(",").map((d) => d.trim()).filter(Boolean)
  : [];

const contingentes2026 = (ficha.contingentes?.["2026f1"] ?? [])
  .slice()
  .sort((a, b) => b.nota - a.nota);

const formas = info?.formas_ingresso;
const segmentosIngresso = formas
  ? [
      { rotulo: "concurso nacional, em 1ª opção", valor: formas.cna_1opcao, classe: "fica" },
      { rotulo: "concurso nacional, outras opções", valor: formas.cna_outras, classe: "muda-inst" },
      { rotulo: "maiores de 23", valor: formas.maiores_23, classe: "muda-curso" },
      {
        rotulo: "outras vias (mudança de curso, concursos locais, outros regimes)",
        valor: Math.round((formas.mudanca_curso + formas.concurso_local + formas.outros) * 10) / 10,
        classe: "fora",
      },
    ].filter((s) => s.valor > 0)
  : [];

const distribuicao = info?.diplomados?.distribuicao ?? null;
const maxDistribuicao = distribuicao ? Math.max(...Object.values(distribuicao)) : 0;

const idades = info?.idades;
const segmentosIdade = idades
  ? [
      { rotulo: "até 19 anos", valor: idades.pct_ate_19, classe: "fica" },
      { rotulo: "20–23 anos", valor: idades.pct_20_a_23, classe: "muda-inst" },
      { rotulo: "24 ou mais", valor: idades.pct_24_ou_mais, classe: "fora" },
    ].filter((s) => s.valor > 0)
  : [];

const inscritosSerie = info?.inscritos_serie
  ? Object.entries(info.inscritos_serie)
      .map(([anoLetivo, valor]) => ({ ano: Number(anoLetivo.slice(5)), valor: valor as number }))
      .sort((a, b) => a.ano - b.ano)
  : [];

const mediasCandidatura = serieAnual(ficha, "media_candidatura", 1);
const mediasSecundario = serieAnual(ficha, "media_secundario", 1);
const percentilRecente = percentilEntrada.length
  ? info?.percentil_entrada?.[String(percentilEntrada[percentilEntrada.length - 1].ano)]
  : null;

/* Séries demográficas (edições cruzadas do Infocursos). */
const demografia = info?.demografia_serie
  ? Object.entries(info.demografia_serie).map(([al, v]) => ({
      ano: Number(al.slice(0, 4)) + 1,
      mulheres: v.mulheres != null && v.inscritos ? Math.round((100 * v.mulheres) / v.inscritos) : null,
      estrangeiros: v.estrangeiros != null && v.inscritos ? Math.round((100 * v.estrangeiros) / v.inscritos) : null,
    }))
  : [];
const serieMulheres = demografia.filter((d) => d.mulheres != null).map((d) => ({ ano: d.ano, valor: d.mulheres! }));
const serieEstrangeiros = demografia.filter((d) => d.estrangeiros != null).map((d) => ({ ano: d.ano, valor: d.estrangeiros! }));

/* O padrão das fases deste curso: em quantos anos a 2ª fechou acima da 1ª? */
const paresFases = Object.keys(ficha.series)
  .filter((k) => k.endsWith("f1"))
  .map((k) => {
    const ano = Number(k.slice(0, 4));
    const n1 = ficha.series[`${ano}f1`]?.nota_ultimo;
    const n2 = ficha.series[`${ano}f2`]?.nota_ultimo;
    return n1 != null && n2 != null ? { ano, delta: Math.round((n2 - n1) * 10) / 10 } : null;
  })
  .filter((x): x is { ano: number; delta: number } => x != null);
const fasesSobe = paresFases.filter((x) => x.delta > 0).length;

/* O perfil: cinco dimensões, todas como percentil nacional. */
const perfil = [
  { rotulo: "nota de corte", pct: ficha.percentil_nota_2026 ?? null, cor: "nota", nota: "acima de" },
  { rotulo: "procura em 1ª opção por vaga", pct: ficha.percentil_procura ?? null, cor: "procura", nota: "acima de" },
  { rotulo: "colocados que o queriam em 1º lugar", pct: ficha.percentil_fidelidade ?? null, cor: "fidelidade", nota: "acima de" },
  { rotulo: "permanência ao fim de 1 ano", pct: ficha.percentil_fica ?? null, cor: "fica", nota: "acima de" },
  {
    rotulo: "emprego à saída (menos desemprego)",
    pct: ficha.desemprego_percentil != null ? 100 - ficha.desemprego_percentil : null,
    cor: "emprego",
    nota: "melhor do que",
  },
].filter((d) => d.pct != null);

const urlPortal = new URL(ligacao("/"), Astro.site).href;
const urlCursos = new URL(ligacao("/cursos/"), Astro.site).href;
const urlFicha = new URL(ligacaoCurso(ficha), Astro.site).href;

const titulo = `${ficha.curso} — ${ficha.instituicao}`;
const descricao =
  nota2026 != null
    ? `Nota do último colocado em 2026: ${formatarNota(nota2026)} pontos. Vagas, colocados e procura de 2018 a 2026.`
    : `Vagas, colocados e procura no Concurso Nacional de Acesso, 2018 a 2026.`;
---

<Base
  titulo={titulo}
  descricao={descricao}
  ogImagem={ficha.ativo && ficha.concurso === "Nacional" ? `/og/${ficha.par}.png` : undefined}
>
  {/* O palco: a nota de corte como protagonista, na escala que toda a gente
      conhece. Banda escura deliberada nos dois temas — é o «papel de pauta»
      da página. Sem JavaScript fica tudo visível e parado. */}
  <section class="palco reveal">
    <div class="palco__grelha">
      <div class="palco__id">
        <p class="palco__kicker">
          {ficha.grupo}
          {ficha.cnaef_nome && (
            <>
              {" · "}
              <a class="palco__kicker-link" href={ligacao(`/area/${slug(ficha.cnaef_nome)}/`)}>
                {ficha.cnaef_nome}
              </a>
            </>
          )}
        </p>
        <h1 class="palco__titulo">{ficha.curso}</h1>
        <span class="palco__filete cresce" aria-hidden="true"></span>
        <p class="palco__inst">
          {ficha.instituicao}
          {!ficha.ativo && " · sem oferta no concurso de 2026"}
        </p>
        <div class="palco__chips">
          {
            ficha.vagas_2026 != null && (
              <span class="palco__chip palco__chip--a">
                <b>{formatarInteiro(ficha.vagas_2026)}</b> vagas em 2026
                {f1_2026.sobras === 0 && " · esgotadas na 1ª fase"}
                {(f1_2026.sobras ?? 0) > 0 && ` · ${formatarInteiro(f1_2026.sobras)} por preencher`}
              </span>
            )
          }
          {
            procura != null && (
              <span class="palco__chip palco__chip--b">
                <b>{formatarInteiro(procura)}</b> puseram-no em 1ª opção (2025)
              </span>
            )
          }
        </div>
      </div>

      <div class="palco__nota">
        <p class="palco__nota-rotulo">nota do último colocado · 1ª fase 2026</p>
        {
          nota2026 != null ? (
            <>
              <p class="palco__numero" data-contar={nota2026} data-casas="1">
                {formatarNota(nota2026)}
              </p>
              {variacao != null && (
                <p
                  class={`palco__variacao ${variacao >= 0 ? "palco__variacao--sobe" : "palco__variacao--desce"}`}
                >
                  <span class="palco__seta" aria-hidden="true">
                    {variacao >= 0 ? "↗" : "↘"}
                  </span>
                  {variacao >= 0 ? "+" : "−"}
                  {Math.abs(variacao).toLocaleString("pt-PT", {
                    minimumFractionDigits: 1,
                    maximumFractionDigits: 1,
                  })}{" "}
                  face a 2025
                </p>
              )}
            </>
          ) : (
            <>
              <p class="palco__numero palco__numero--vazio">—</p>
              <p class="palco__variacao">
                não preencheu as vagas na 1ª fase — entra-se com a nota mínima
              </p>
            </>
          )
        }
      </div>
    </div>

    <div class="palco__regua" aria-hidden={nota2026 == null ? "true" : undefined}>
      <div
        class="palco__pista"
        role="img"
        aria-label={
          nota2026 != null
            ? `Régua de 90 a 200 pontos: a nota de corte de 2026 é ${formatarNota(nota2026)}${nota2025 != null ? `; em 2025 foi ${formatarNota(nota2025)}` : ""}`
            : "Régua de 90 a 200 pontos, sem nota de corte em 2026"
        }
      >
        {eixos.map((v) => <span class="palco__tick" style={`left:${pos(v)}%`} />)}
        {
          nota2026 != null && (
            <span class="palco__fill cresce" style={`width:${pos(nota2026)}%;--d:.15s`} />
          )
        }
        {
          nota2025 != null && (
            <span
              class="palco__fantasma"
              style={`left:${pos(nota2025)}%`}
              title={`1ª fase 2025: ${formatarNota(nota2025)}`}
            />
          )
        }
        {
          nota2026 != null && (
            <span class="palco__marca" style={`left:${pos(nota2026)}%`}>
              <span class="palco__halo" aria-hidden="true" />
            </span>
          )
        }
      </div>
      <div class="palco__eixo" aria-hidden="true">
        {eixos.map((v) => <span style={`left:${pos(v)}%`}>{v}</span>)}
      </div>
      <p class="palco__legenda">
        Escala de candidatura 0–200 · o anel oco é a nota de 2025 · abaixo de 90 nenhum
        curso público coloca
      </p>
    </div>
  </section>

  {
    ficha.formula_pesos && (
      <section
        class="card full simulador js-so reveal"
        hidden
        data-simulador
        data-pesos={JSON.stringify(ficha.formula_pesos)}
        data-corte={nota2026 ?? ""}
        data-minimo={ficha.minimo_candidatura ?? ""}
      >
        <h3>Entrava com as minhas notas?</h3>
        <p class="desc">
          A fórmula deste curso: média do secundário ×{ficha.formula_pesos.secundario}% +
          provas de ingresso ×{ficha.formula_pesos.provas}%. Preencha e veja onde a sua
          nota cai.
        </p>
        <div class="simulador__campos">
          <label>
            média do secundário (0–20)
            <input type="number" min="0" max="20" step="0.1" inputmode="decimal" placeholder="15,4" data-sim-sec />
          </label>
          <label>
            média das provas de ingresso (0–200)
            <input type="number" min="0" max="200" step="0.5" inputmode="decimal" placeholder="132" data-sim-provas />
          </label>
          <output class="simulador__nota" data-sim-nota aria-live="polite"></output>
        </div>
        <p class="simulador__veredito" data-sim-veredito aria-live="polite"></p>
        <p class="cautela">
          Simulação com as regras de 2026 e a nota de corte da 1ª fase pelo contingente
          geral — a próxima época terá corte diferente. Confirme os pré-requisitos e o
          conjunto de provas exigido.
        </p>
      </section>
    )
  }

  <div class="stats">
    <div class="stat reveal">
      <b {...ficha.vagas_2026 != null ? { "data-contar": ficha.vagas_2026 } : {}}>
        {formatarInteiro(ficha.vagas_2026)}
      </b>
      <span>vagas em 2026</span>
    </div>
    <div class="stat reveal" style="--d:.08s">
      <b {...f1_2026.colocados != null ? { "data-contar": f1_2026.colocados } : {}}>
        {formatarInteiro(f1_2026.colocados)}
      </b>
      <span>colocados na 1ª fase de 2026</span>
    </div>
    <div class="stat reveal" style="--d:.16s">
      <b {...f1_2026.sobras != null ? { "data-contar": f1_2026.sobras } : {}}>
        {formatarInteiro(f1_2026.sobras)}
      </b>
      <span>vagas sobrantes para a 2ª fase</span>
    </div>
    <div class="stat reveal" style="--d:.24s">
      <b {...racio != null ? { "data-contar": Math.round(racio * 10) / 10, "data-casas": 1 } : {}}>
        {racio != null ? racio.toLocaleString("pt-PT", { minimumFractionDigits: 1, maximumFractionDigits: 1 }) : "—"}
      </b>
      <span>candidatos em 1ª opção por vaga (2025)</span>
    </div>
  </div>

  <div class="grid">
    <section class="card">
      <h3>Evolução da nota do último colocado</h3>
      <SerieAnual
        titulo="Pontos na escala 0–200, por época"
        unidade="pontos"
        series={[
          { rotulo: "1ª fase", pontos: notasF1, cor: "serie-1" },
          { rotulo: "2ª fase", pontos: notasF2, cor: "serie-2" },
        ]}
      />
      <p class="cautela">
        A nota do último colocado mede o equilíbrio entre procura e vagas, não a qualidade
        do curso. Só existe nas fases em que todas as vagas se preencheram.
      </p>
      {
        paresFases.length >= 3 && (
          <p class="fases-padrao">
            <b>Esperar pela 2ª fase?</b> Neste curso, a 2ª fase fechou <b>acima</b> da 1ª
            em {fasesSobe} de {paresFases.length} anos
            {" ("}
            {paresFases
              .slice(-4)
              .map((x) => `${String(x.ano).slice(2)}: ${x.delta > 0 ? "+" : ""}${x.delta.toLocaleString("pt-PT")}`)
              .join(" · ")}
            {")"}.
          </p>
        )
      }
    </section>

    <section class="card">
      <h3>Procura</h3>
      <SerieAnual
        titulo="Candidaturas à 1ª fase"
        unidade="candidaturas"
        inteiro
        series={[
          { rotulo: "Candidatos", pontos: candidatos, cor: "serie-1" },
          { rotulo: "Em 1ª opção", pontos: candidatos1op, cor: "serie-2" },
        ]}
      />
      <p class="cautela">
        Cada estudante concorre até seis pares curso/instituição: os candidatos contam
        candidaturas, não pessoas. Os em 1ª opção são a medida honesta da procura.
      </p>
    </section>

    <section class="card reveal">
      <h3>Como se entra</h3>
      {
        provas ? (
          <>
            <h4 class="sub">
              Provas de ingresso
              {provas.escolha && provas.grupos.length > 1 && " — um destes conjuntos"}
            </h4>
            <ul class="conjuntos">
              {provas.grupos.map((grupo, i) => (
                <>
                  {i > 0 && (
                    <li class="conjuntos__ou" aria-label="ou, em alternativa">
                      ou
                    </li>
                  )}
                  <li class="conjuntos__grupo">
                    {grupo.map((p) => (
                      <span class="prova">
                        <span class="prova__cod" aria-hidden="true">
                          {p.cod}
                        </span>
                        {p.nome}
                      </span>
                    ))}
                  </li>
                </>
              ))}
            </ul>
          </>
        ) : (
          ficha.provas_ingresso && (
            <>
              <h4 class="sub">Provas de ingresso</h4>
              <pre class="provas">{ficha.provas_ingresso}</pre>
            </>
          )
        )
      }

      {
        ficha.formula_pesos ? (
          <>
            <h4 class="sub">Fórmula da nota de candidatura</h4>
            <div
              class="pesos"
              role="img"
              aria-label={`Média do secundário ${ficha.formula_pesos.secundario} por cento; provas de ingresso ${ficha.formula_pesos.provas} por cento`}
            >
              <span class="pesos__seg pesos__seg--sec cresce" style={`width:${ficha.formula_pesos.secundario}%`}>
                <b>{ficha.formula_pesos.secundario}%</b> secundário
              </span>
              <span
                class="pesos__seg pesos__seg--provas cresce"
                style={`width:${ficha.formula_pesos.provas}%;--d:.12s`}
              >
                <b>{ficha.formula_pesos.provas}%</b> provas
              </span>
            </div>
          </>
        ) : (
          ficha.formula && (
            <>
              <h4 class="sub">Fórmula</h4>
              <pre class="provas">{ficha.formula}</pre>
            </>
          )
        )
      }

      <ul class="requisitos">
        {
          ficha.minimo_candidatura != null && (
            <li>
              <b>{ficha.minimo_candidatura}</b> mínimo de candidatura
            </li>
          )
        }
        {
          ficha.minimo_provas != null && (
            <li>
              <b>{ficha.minimo_provas}</b> mínimo nas provas
            </li>
          )
        }
        {
          ficha.ects != null && (
            <li>
              <b>{ficha.ects}</b> ECTS
            </li>
          )
        }
        {
          ficha.duracao && (
            <li>
              <b>{ficha.duracao.replace(/\D+$/, "")}</b>
              {ficha.duracao.replace(/^[\d\s]+/, "").toLowerCase()}
            </li>
          )
        }
      </ul>

      {
        ficha.preferencia_regional && (
          <div class="pref">
            <p class="pref__texto">
              <b>{ficha.preferencia_regional.pct_vagas}% das vagas</b> com preferência
              regional para quem concluiu o secundário em:
            </p>
            <ul class="pref__distritos">
              {distritosPreferencia.map((d) => <li>{d}</li>)}
            </ul>
            {ficha.acessos_preferenciais_pct != null && (
              <p class="pref__texto pref__texto--extra">
                Mais {ficha.acessos_preferenciais_pct}% para cursos com acesso preferencial.
              </p>
            )}
          </div>
        )
      }
    </section>

    {
      contingentes2026.length > 1 && (
        <section class="card reveal">
          <h3>Notas por contingente — 1ª fase 2026</h3>
          <p class="desc">
            Antes do contingente geral, a DGES coloca primeiro os contingentes
            prioritários — cada um com a sua nota de corte.
          </p>
          <ol class="viz">
            {contingentes2026.map((c) => (
              <li>
                <span class={`viz__linha ${c.nome === "Contingente geral" ? "viz__linha--geral" : ""}`}>
                  <span class="viz__nome">{c.nome}</span>
                  <span class="viz__pista" aria-hidden="true">
                    <span class="viz__ponto" style={`left:${pos(c.nota)}%`} />
                  </span>
                  <span class="viz__nota">{formatarNota(c.nota)}</span>
                </span>
              </li>
            ))}
          </ol>
          <p class="fonte-lin">
            Açores, Madeira, emigrantes, militares, candidatos com deficiência e
            beneficiários ASE têm quotas próprias; só aparecem quando colocaram alguém.
