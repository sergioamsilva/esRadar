<script>
  /* Simulador de nota de candidatura: pesos, corte e mínimo vêm nos data-
     attributes; re-arma em cada navegação do ClientRouter. */
  const iniciarSimulador = () => {
    const caixa = document.querySelector<HTMLElement>("[data-simulador]");
    if (!caixa || caixa.dataset.armado) return;
    caixa.dataset.armado = "1";
    caixa.hidden = false;

    const pesos = JSON.parse(caixa.dataset.pesos!);
    const corte = caixa.dataset.corte ? Number(caixa.dataset.corte) : null;
    const minimo = caixa.dataset.minimo ? Number(caixa.dataset.minimo) : null;
    const sec = caixa.querySelector<HTMLInputElement>("[data-sim-sec]")!;
    const provas = caixa.querySelector<HTMLInputElement>("[data-sim-provas]")!;
    const nota = caixa.querySelector<HTMLElement>("[data-sim-nota]")!;
    const veredito = caixa.querySelector<HTMLElement>("[data-sim-veredito]")!;

    const calcular = () => {
      const s = parseFloat(sec.value.replace(",", "."));
      const p = parseFloat(provas.value.replace(",", "."));
      if (!isFinite(s) || !isFinite(p)) {
        nota.textContent = "";
        veredito.textContent = "";
        veredito.className = "simulador__veredito";
        return;
      }
      const candidatura = (s * 10 * pesos.secundario) / 100 + (p * pesos.provas) / 100;
      nota.textContent = candidatura.toLocaleString("pt-PT", {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1,
      });
      let texto = "";
      let classe = "simulador__veredito";
      if (minimo != null && candidatura < minimo) {
        texto = `Abaixo do mínimo de candidatura (${minimo} pontos) — não pode concorrer a este curso.`;
        classe += " nao-entra";
      } else if (corte != null) {
        const delta = candidatura - corte;
        const deltaTxt = Math.abs(delta).toLocaleString("pt-PT", { maximumFractionDigits: 1 });
        if (delta >= 0) {
          texto = `Em 2026 teria entrado na 1ª fase — ${deltaTxt} pontos acima da nota do último colocado.`;
          classe += " entra";
        } else {
          texto = `Em 2026 não teria entrado na 1ª fase: ${deltaTxt} pontos abaixo da nota do último colocado.`;
          classe += " nao-entra";
        }
      } else {
        texto = "Este curso não preencheu as vagas em 2026 — com o mínimo satisfeito, teria entrado.";
        classe += " entra";
      }
      veredito.textContent = texto;
      veredito.className = classe;
    };
    sec.addEventListener("input", calcular);
    provas.addEventListener("input", calcular);
  };
  iniciarSimulador();
  document.addEventListener("astro:page-load", iniciarSimulador);
</script>

<style>
  /* ── o palco ─────────────────────────────────────────────────────────
     Full-bleed: sai do wrap e volta a alinhar o conteúdo com padding. É
     escuro nos dois temas de propósito — cores explícitas, não tokens. */
  .palco {
    margin-inline: calc(50% - 50vw);
    padding: clamp(30px, 5vw, 56px) calc(50vw - 50%) clamp(24px, 4vw, 40px);
    background:
      radial-gradient(1100px 420px at 85% -10%, rgba(57, 135, 229, 0.38), transparent 65%),
      radial-gradient(700px 360px at -5% 110%, rgba(208, 105, 42, 0.22), transparent 60%),
      linear-gradient(118deg, #0a1422 0%, #10233c 55%, #0c1a2e 100%);
    color: #fff;
  }
  .palco__grelha {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) auto;
    gap: clamp(20px, 4vw, 56px);
    align-items: start;
  }
  .palco__kicker {
    font-size: var(--t-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 10px;
  }
  .palco__titulo {
    font-size: clamp(32px, 5.6vw, 62px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    margin: 0;
    max-width: 18ch;
  }
  .palco__filete {
    display: block;
    width: clamp(64px, 8vw, 110px);
    height: 4px;
    border-radius: 2px;
    margin: 16px 0 12px;
    background: linear-gradient(90deg, #3987e5, #7cc0ff);
  }
  .palco__kicker-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }
  .palco__kicker-link:hover {
    color: #fff;
  }
  .palco__inst {
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--t-md);
    margin: 0 0 18px;
  }
  .palco__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .palco__chip {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: var(--t-xs);
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .palco__chip b {
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .palco__chip--a {
    animation: flutua 6.2s ease-in-out infinite;
  }
  .palco__chip--b {
    animation: flutua 7.4s ease-in-out 0.9s infinite;
  }
  @keyframes flutua {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-5px);
    }
  }

  .palco__nota {
    text-align: right;
    min-width: 0;
  }
  .palco__nota-rotulo {
    font-size: var(--t-2xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
    margin: 4px 0 2px;
  }
  .palco__numero {
    font-size: clamp(58px, 9vw, 108px);
    font-weight: 780;
    letter-spacing: -0.03em;
    line-height: 1;
    margin: 0;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(100deg, #fff 30%, #9ecbff 90%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #9ecbff;
  }
  .palco__numero--vazio {
    color: rgba(255, 255, 255, 0.4);
    -webkit-text-fill-color: initial;
    background: none;
  }
  .palco__variacao {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 10px 0 0;
    font-size: var(--t-sm);
    font-variant-numeric: tabular-nums;
    color: rgba(255, 255, 255, 0.75);
  }
  .palco__variacao--sobe {
    color: #7fe3ad;
  }
  .palco__variacao--desce {
    color: #ffa1a1;
  }
  .palco__seta {
    display: inline-block;
    transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1s;
  }
  :global(html.js) .palco:not(.on) .palco__seta {
    transform: translate(-6px, 6px);
    opacity: 0;
  }

  /* ── a régua do palco ────────────────────────────────────────────── */
  .palco__regua {
    margin-top: clamp(26px, 4vw, 40px);
  }
  .palco__pista {
    position: relative;
    height: 6px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.16);
  }
  .palco__tick {
    position: absolute;
    top: -4px;
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.22);
  }
  .palco__fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 3px;
    background: linear-gradient(90deg, rgba(57, 135, 229, 0.35), #3987e5 70%, #7cc0ff);
    box-shadow: 0 0 18px rgba(57, 135, 229, 0.55);
  }
  .palco__fantasma {
