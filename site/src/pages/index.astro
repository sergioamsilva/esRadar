---
import Base from "../layouts/Base.astro";
import SerieAnual from "../components/SerieAnual.astro";
import Mapa from "../components/Mapa.astro";
import Dispersao from "../components/Dispersao.astro";
import { cursos, pares, nacional, epoca, genero, instituicoes, fases, historias, ligacao, ligacaoCurso, formatarInteiro, formatarNota } from "../lib/dados";

const indice = cursos();
const nac = nacional();
const ep = epoca();
const gen = genero();
const inst = instituicoes();

const vagas2026 = indice.reduce((s, c) => s + (c.vagas ?? 0), 0);
const colocadosF1 = indice.reduce((s, c) => s + (c.colocados_2026f1 ?? 0), 0);
const sobrasF1 = indice.reduce((s, c) => s + (c.sobras_2026f1 ?? 0), 0);

/* Vagas vs. colocados da 1ª fase — comparação limpa: a faixa entre as duas
   linhas são as vagas que sobraram para a 2ª fase, ano a ano. */
const anosNacional = Object.entries(nac.anos)
  .map(([ano, v]) => ({ ano: Number(ano), vagas: v.vagas_f1, colocados: v.colocados_f1 }))
  .filter((p) => p.vagas > 0 && p.colocados > 0)
  .sort((a, b) => a.ano - b.ano);

const VC = { L: 100, A: 56, esq: 2, dir: 11, topo: 6, base: 16 };
const vcMax = Math.max(...anosNacional.map((p) => p.vagas)) * 1.04;
const vcMin = Math.min(...anosNacional.map((p) => p.colocados)) * 0.96;
const vcX = (ano: number) =>
  VC.esq + ((ano - anosNacional[0].ano) / (anosNacional[anosNacional.length - 1].ano - anosNacional[0].ano)) * (VC.L - VC.esq - VC.dir);
const vcY = (v: number) => VC.topo + (1 - (v - vcMin) / (vcMax - vcMin)) * (VC.A - VC.topo - VC.base);
const f2 = (n: number) => n.toFixed(2);
const vcLinha = (campo: "vagas" | "colocados") =>
  anosNacional.map((p, i) => `${i ? "L" : "M"}${f2(vcX(p.ano))},${f2(vcY(p[campo]))}`).join(" ");
const vcBanda =
  anosNacional.map((p, i) => `${i ? "L" : "M"}${f2(vcX(p.ano))},${f2(vcY(p.vagas))}`).join(" ") +
  [...anosNacional].reverse().map((p) => ` L${f2(vcX(p.ano))},${f2(vcY(p.colocados))}`).join("") +
  " Z";
const vcUltimo = anosNacional[anosNacional.length - 1];

/* Maiores movimentos da nota de corte entre 2025 e 2026, 1ª fase. */
const comVariacao = indice
  .filter((c) => c.nota_2026f1 != null && c.nota_2025f1 != null)
  .map((c) => ({ ...c, delta: c.nota_2026f1! - c.nota_2025f1! }));
const subidas = [...comVariacao].sort((a, b) => b.delta - a.delta).slice(0, 6);
const descidas = [...comVariacao].sort((a, b) => a.delta - b.delta).slice(0, 6);

/* Distribuição das notas de corte de 2026: caixas de 5 pontos, 95–200. */
const notas2026 = indice.map((c) => c.nota_2026f1).filter((n): n is number => n != null);
const mediana = [...notas2026].sort((a, b) => a - b)[Math.floor(notas2026.length / 2)];
const caixas: { de: number; n: number }[] = [];
for (let de = 95; de < 200; de += 5) caixas.push({ de, n: 0 });
for (const n of notas2026) {
  const i = Math.min(caixas.length - 1, Math.max(0, Math.floor((n - 95) / 5)));
  caixas[i].n++;
}
const maxCaixa = Math.max(...caixas.map((c) => c.n));

/* As áreas de 2026, pelas colocações. */
const porArea = new Map<string, { colocados: number; vagas: number; sobras: number; notas: number[] }>();
for (const c of indice) {
  if (!c.cnaef_nome) continue;
  const a = porArea.get(c.cnaef_nome) ?? { colocados: 0, vagas: 0, sobras: 0, notas: [] };
  a.colocados += c.colocados_2026f1 ?? 0;
  a.vagas += c.vagas ?? 0;
  a.sobras += c.sobras_2026f1 ?? 0;
  if (c.nota_2026f1 != null) a.notas.push(c.nota_2026f1);
  porArea.set(c.cnaef_nome, a);
}
const areas = [...porArea.entries()]
  .map(([area, a]) => ({
    area,
    ...a,
    ocupacao: a.vagas ? a.colocados / a.vagas : 0,
    notaMediana: a.notas.length ? [...a.notas].sort((x, y) => x - y)[Math.floor(a.notas.length / 2)] : null,
  }))
  .sort((a, b) => b.colocados - a.colocados)
  .slice(0, 12);
const maxAreaColocados = Math.max(...areas.map((a) => a.colocados));

/* Rankings rápidos. */
const disputados = [...indice]
  .filter((c) => c.nota_2026f1 != null)
  .sort((a, b) => b.nota_2026f1! - a.nota_2026f1!)
  .slice(0, 6);
const procurados = [...indice]
  .filter((c) => c.racio_procura != null && (c.vagas ?? 0) >= 20)
  .sort((a, b) => b.racio_procura! - a.racio_procura!)
  .slice(0, 6);
const maisSobras = [...indice]
  .filter((c) => (c.sobras_2026f1 ?? 0) > 0)
  .sort((a, b) => b.sobras_2026f1! - a.sobras_2026f1!)
  .slice(0, 6);
const menorDesemprego = [...indice]
  .filter((c) => c.desemprego != null && (c.colocados_2026f1 ?? 0) >= 30)
  .sort((a, b) => a.desemprego! - b.desemprego!)
  .slice(0, 6);

const gn = gen.nacional;
const pctColocadas = Math.round((100 * gn.colocados_mulheres) / (gn.colocados_mulheres + gn.colocados_homens));

/* «Onde entro com a minha média?» — notas de corte compactas p/ o cliente. */
const ALCANCE = indice
  .filter((c) => c.nota_2026f1 != null || (c.sobras_2026f1 ?? 0) > 0)
  .map((c) => ({ n: c.nota_2026f1, c: c.curso, i: c.grupo, u: ligacaoCurso(c) }));
const fasesTexto = ep.fases_arquivadas.map((f) => `${f}ª`).join(", ");

/* ── radar de histórias, 2ª fase e bump chart ─────────────────────── */
const radar = historias();
const ICONES: Record<string, string> = {
  recorde: "🏔", salto: "▲", queda: "▼", esgotou: "⛔", estreia: "✦", fuga: "↯",
};
const f2f = fases();
const caixasFases = Object.entries(f2f.caixas)
  .map(([k, n]) => ({ delta: Number(k), n }))
  .sort((a, b) => a.delta - b.delta);
const maxCaixaFase = Math.max(...caixasFases.map((c) => c.n));
const absorcaoRecente = Object.entries(f2f.absorcao).filter(([a]) => Number(a) < 2026).slice(-3);

/* Bump: os 20 mais disputados de 2026 e as suas posições desde 2018. */
const ANOS_BUMP = [2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];
const fichasCNA = pares().filter((p) => p.ativo && p.concurso === "Nacional");
const rankPorAno = new Map<number, Map<string, number>>();
for (const ano of ANOS_BUMP) {
  const comNota = fichasCNA
    .map((p) => ({ par: p.par, nota: p.series[`${ano}f1`]?.nota_ultimo }))
    .filter((x): x is { par: string; nota: number } => x.nota != null)
    .sort((a, b) => b.nota - a.nota);
  const m = new Map<string, number>();
  comNota.forEach((x, i) => m.set(x.par, i + 1));
  rankPorAno.set(ano, m);
}
const top20 = fichasCNA
  .filter((p) => rankPorAno.get(2026)?.has(p.par))
  .sort((a, b) => rankPorAno.get(2026)!.get(a.par)! - rankPorAno.get(2026)!.get(b.par)!)
  .slice(0, 20);
const RANK_MAX = 30;
const bump = top20.map((p) => ({
  p,
  nome: p.curso.length > 26 ? p.curso.slice(0, 25).trimEnd() + "…" : p.curso,
  trajeto: ANOS_BUMP.map((ano) => {
    const r = rankPorAno.get(ano)?.get(p.par) ?? null;
    return { ano, rank: r, recortado: r != null && r > RANK_MAX };
  }),
  rank2026: rankPorAno.get(2026)!.get(p.par)!,
}));
const BX = (ano: number) => 4 + ((ano - 2018) / 8) * 74;
const BY = (rank: number) => 4 + ((Math.min(rank, RANK_MAX) - 1) / (RANK_MAX - 1)) * 88;

/* ── funil do acesso: o último ano completo (2025), da oferta à permanência. */
const a25 = nac.anos["2025"];
let ficaNum = 0, ficaDen = 0;
for (const c of indice) {
  if (c.fica_1ano != null && c.colocados_2026f1) {
    ficaNum += c.fica_1ano * c.colocados_2026f1;
    ficaDen += c.colocados_2026f1;
  }
}
const ficaPct = ficaDen ? ficaNum / ficaDen : null;
const funil = a25
  ? [
      { rotulo: "vagas postas a concurso", valor: a25.vagas_f1, detalhe: "1ª fase de 2025" },
      { rotulo: "colocados na 1ª fase", valor: a25.colocados_f1, detalhe: `${Math.round((100 * a25.colocados_f1) / a25.vagas_f1)}% das vagas` },
      { rotulo: "colocados no fim das 3 fases", valor: a25.colocados, detalhe: `+${formatarInteiro(a25.colocados_f2)} na 2ª, +${formatarInteiro(a25.colocados_f3)} na 3ª` },
      ...(ficaPct != null
        ? [{ rotulo: "continuam no mesmo curso um ano depois", valor: Math.round(a25.colocados * (ficaPct / 100)), detalhe: `${Math.round(ficaPct)}% de permanência típica (Infocursos)` }]
        : []),
    ]
  : [];
const funilMax = funil.length ? funil[0].valor : 1;

/* ── dispersão procura × nota: o retrato dos 1170 num só plano. */
const pontosProcura = indice
  .filter((c) => c.racio_procura != null && c.nota_2026f1 != null)
  .map((c) => ({
    x: c.racio_procura!,
    y: c.nota_2026f1!,
    rotulo: `${c.curso} — ${c.grupo}`,
    detalhe: `corte ${formatarNota(c.nota_2026f1)} · ${c.racio_procura!.toLocaleString("pt-PT", { maximumFractionDigits: 1 })}× procura em 1ª opção · ${formatarInteiro(c.vagas)} vagas`,
    url: ligacaoCurso(c),
    cor: (c.subsistema === "politecnico" ? "serie-2" : "serie-1") as "serie-1" | "serie-2",
  }));

/* ── elasticidade: quem mexeu nas vagas, e o que fez a nota (2025→2026). */
const pontosElastico = pares()
  .filter((p) => p.ativo && p.concurso === "Nacional")
  .map((p) => {
    const v25 = p.series["2025f1"]?.vagas;
    const n25 = p.series["2025f1"]?.nota_ultimo;
    const n26 = p.series["2026f1"]?.nota_ultimo;
    const v26 = p.vagas_2026;
    if (!v25 || v25 < 10 || v26 == null || n25 == null || n26 == null) return null;
    const dv = Math.round(((v26 - v25) / v25) * 100);
    const dn = Math.round((n26 - n25) * 10) / 10;
    return {
      x: dv,
      y: dn,
      rotulo: `${p.curso} — ${p.grupo}`,
      detalhe: `vagas ${v25}→${v26} (${dv >= 0 ? "+" : ""}${dv}%) · nota ${formatarNota(n25)}→${formatarNota(n26)} (${dn >= 0 ? "+" : ""}${dn.toLocaleString("pt-PT")})`,
      url: ligacaoCurso({ par: p.par, curso: p.curso }),
      cor: (p.subsistema === "politecnico" ? "serie-2" : "serie-1") as "serie-1" | "serie-2",
    };
  })
  .filter((x): x is NonNullable<typeof x> => x != null && Math.abs(x.x) <= 60);

/* URLs absolutos para o JSON-LD (o Astro global não chega às expressões
   dos scripts is:inline). */
const urlPortal = new URL(ligacao("/"), Astro.site).href;
const urlCursos = new URL(ligacao("/cursos/"), Astro.site).href;
---

<Base
  titulo="Panorama"
  descricao="As colocações no ensino superior público, curso a curso: notas do último colocado, vagas, procura, áreas, género e sobras, de 2018 a 2026."
>
  <section class="hero">
    <h1>
      Este ano, <b data-contar={colocadosF1}>{formatarInteiro(colocadosF1)}</b> estudantes entraram na 1ª fase.
      <span class="hero__sub">Sobraram {formatarInteiro(sobrasF1)} vagas para a 2ª.</span>
    </h1>
    <p class="desc medida">
      O esRadar reorganiza os resultados do Concurso Nacional de Acesso publicados pela
      DGES — incluindo os anos que a DGES já retirou do ar, recuperados do Arquivo.pt.
      Época de 2026: {fasesTexto} fase{ep.fases_arquivadas.length > 1 ? "s" : ""} arquivada{ep.fases_arquivadas.length > 1 ? "s" : ""}.
    </p>
  </section>

  <div class="stats">
    <div class="stat reveal">
      <b data-contar={vagas2026}>{formatarInteiro(vagas2026)}</b>
      <span>vagas iniciais em 2026</span>
      <em>{formatarInteiro(indice.length)} pares curso/instituição</em>
    </div>
    <div class="stat reveal" style="--d:.08s">
      <b data-contar={mediana} data-casas="1">{formatarNota(mediana)}</b>
      <span>nota de corte mediana, 1ª fase</span>
      <em>{formatarInteiro(notas2026.length)} cursos preencheram as vagas</em>
    </div>
    <div class="stat reveal" style="--d:.16s">
      <b data-contar={sobrasF1}>{formatarInteiro(sobrasF1)}</b>
      <span>vagas sobrantes para a 2ª fase</span>
    </div>
    <div class="stat reveal" style="--d:.24s">
      <b
        ><span data-contar={vagas2026 ? Math.round(((vagas2026 - sobrasF1) / vagas2026) * 100) : 0}
          >{vagas2026 ? Math.round(((vagas2026 - sobrasF1) / vagas2026) * 100) : 0}</span
        >%</b
      >
      <span>taxa de ocupação na 1ª fase</span>
    </div>
  </div>

  <section class="card full alcance js-so reveal" hidden data-alcance>
    <h3>Onde entrava com a minha média?</h3>
    <p class="desc">
      Arraste até à sua nota de candidatura (0–200) e veja quantos cursos ficaram ao seu
      alcance na 1ª fase de 2026 — nota de corte igual ou abaixo da sua, ou vagas por
      preencher.
    </p>
    <div class="alcance__controlo">
      <input
        type="range"
        min="95"
        max="200"
        step="0.5"
        value="140"
        data-alcance-nota
        aria-label="A minha nota de candidatura, de 95 a 200"
      />
      <output class="alcance__valor" data-alcance-valor>140,0</output>
    </div>
    <p class="alcance__resultado" data-alcance-resultado aria-live="polite"></p>
    <p class="cautela">
      Aproximação com as notas de corte de 2026 pelo contingente geral: a próxima época
      terá notas diferentes, e cada curso exige provas de ingresso específicas.
    </p>
  </section>
  <script type="application/json" is:inline data-alcance-dados set:html={JSON.stringify(ALCANCE)} />

  <section class="card full reveal radar-card">
    <h3><span class="radar-ping" aria-hidden="true"></span>O radar de histórias</h3>
    <p class="desc">
      Factos notáveis detetados automaticamente nos dados desta época — recordes, saltos,
      estreias e fugas. Renova-se a cada fase arquivada.
    </p>
    <ol class="radar">
      {
        radar.map((h, i) => (
          <li class="reveal" style={`--d:${Math.min(i * 0.07, 0.8)}s`}>
            <a href={ligacao(h.url)} class="radar__item">
              <span class={`radar__tipo radar__tipo--${h.tipo}`} aria-hidden="true">
                {ICONES[h.tipo] ?? "•"}
              </span>
              <span class="radar__texto">{h.texto}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="card full reveal funil-card">
    <h3>O funil do acesso — o ano completo de 2025</h3>
    <p class="desc">
      Da oferta à permanência: cada barra é uma etapa do percurso, à escala.
    </p>
    <ol class="funil">
      {
        funil.map((e, i) => (
          <li class="funil__etapa">
            <span class="funil__texto">
              <b data-contar={e.valor}>{formatarInteiro(e.valor)}</b> {e.rotulo}
              <span>{e.detalhe}</span>
            </span>
            <span class="funil__pista" data-dica={`${formatarInteiro(e.valor)} — ${e.rotulo} (${e.detalhe})`}>
              <span
                class="funil__barra cresce"
                style={`width:${(e.valor / funilMax) * 100}%;--d:${i * 0.15}s;opacity:${1 - i * 0.16}`}
              />
            </span>
          </li>
        ))
      }
    </ol>
    <p class="fonte-lin">
      DGES (3 fases de 2025) e Infocursos (situação após 1 ano, coortes recentes).
    </p>
  </section>

  <section class="card full reveal">
    <h3>Esperar pela 2ª fase compensa?</h3>
    <p class="desc">
      Em {formatarInteiro(f2f.n)} pares curso·ano desde 2018, a nota do último colocado
      <b> subiu na 2ª fase em {f2f.pct_sobe}% dos casos</b> (mediana{" "}
      {f2f.delta_mediano != null && f2f.delta_mediano > 0 ? "+" : ""}{f2f.delta_mediano?.toLocaleString("pt-PT")} pontos).
      Esperar raramente baixa a fasquia — mas as sobras são absorvidas:
      {absorcaoRecente.map(([a, v]) => ` ${v.taxa}% em ${a}`).join(",")}.
    </p>
    <div class="fases2" role="img" aria-label={`Distribuição da diferença de nota entre a 2ª e a 1ª fase: sobe em ${f2f.pct_sobe}% dos casos.`}>
      {
        caixasFases.map((c, i) => (
          <div class="fases2__coluna" data-dica={`${c.delta >= 0 ? "+" : ""}${c.delta} pontos na 2ª fase: ${formatarInteiro(c.n)} pares curso·ano`}>
            <span
              class={`fases2__barra ${c.delta > 0 ? "fases2__barra--sobe" : c.delta < 0 ? "fases2__barra--desce" : ""} cresce`}
              style={`height:${(c.n / maxCaixaFase) * 100}%;--d:${i * 0.05}s`}
            />
            <span class="fases2__rotulo">{c.delta > 0 ? `+${c.delta}` : c.delta}</span>
          </div>
        ))
      }
      <span class="fases2__zero" aria-hidden="true"></span>
    </div>
    <p class="fonte-lin">
      Diferença (2ª − 1ª fase) da nota do último colocado, no mesmo curso e ano, 2018–2025.
      Só cursos que preencheram vagas nas duas fases.
    </p>
  </section>

  <section class="card full reveal">
    <h3>Como se distribuem as notas de corte</h3>
    <p class="desc">
      Cada coluna são os cursos cuja nota do último colocado caiu nesse intervalo de 5
      pontos, na 1ª fase de 2026. O traço é a mediana ({formatarNota(mediana)}).
    </p>
    <div class="hist" role="img" aria-label={`Distribuição das notas de corte de ${formatarInteiro(notas2026.length)} cursos; mediana ${formatarNota(mediana)}.`}>
      {
        caixas.map((c, i) => (
          <div class="hist__coluna" data-dica={`${c.de}–${c.de + 5} pontos: ${c.n} cursos`}>
            <span
              class="hist__barra cresce"
              style={`height:${maxCaixa ? (c.n / maxCaixa) * 100 : 0}%;--d:${i * 0.03}s`}
            />
            {c.de % 20 === 15 ? <span class="hist__rotulo">{c.de + 5}</span> : <span class="hist__rotulo" />}
          </div>
        ))
      }
      <span class="hist__mediana" style={`left:${((mediana - 95) / (200 - 95)) * 100}%`} aria-hidden="true"></span>
    </div>
  </section>

  <section class="card full reveal">
    <h3>O país num só plano: procura contra nota de corte</h3>
    <p class="desc">
      Cada ponto é um curso de 2026 — passe o rato, clique para abrir. As medianas dividem
      o plano em quatro leituras.
    </p>
    <Dispersao
      pontos={pontosProcura}
      eixoX="candidatos em 1ª opção por vaga (2025)"
      eixoY="nota do último colocado (2026)"
      cantos={[
        "exigentes sem multidões — vagas escassas",
        "os disputados: procura e nota altas",
        "as portas abertas — entra-se com o mínimo",
        "muito procurados, corte acessível",
      ]}
    />
    <p class="legenda-scatter">
      <span class="legenda-scatter__chave"><span class="legenda-scatter__ponto legenda-scatter__ponto--u" aria-hidden="true"></span>universitário</span>
      <span class="legenda-scatter__chave"><span class="legenda-scatter__ponto legenda-scatter__ponto--p" aria-hidden="true"></span>politécnico</span>
    </p>
  </section>

  <div class="grid">
    <section class="card reveal vc-card">
      <h3>Vagas e colocados na 1ª fase, ano a ano</h3>
      <p class="desc">
        A faixa entre as linhas são as vagas que sobraram para a 2ª fase. Em 2025 o fosso
        abriu — o ano da mudança nas provas de ingresso — e em 2026 voltou a fechar.
      </p>
      <figure class="vc reveal">
        <svg
          viewBox={`0 0 ${VC.L} ${VC.A}`}
          preserveAspectRatio="none"
          data-hover-serie
          role="img"
          aria-label={`Vagas iniciais e colocados na 1ª fase, ${anosNacional[0].ano} a ${vcUltimo.ano}. Em ${vcUltimo.ano}: ${formatarInteiro(vcUltimo.vagas)} vagas, ${formatarInteiro(vcUltimo.colocados)} colocados, ${formatarInteiro(vcUltimo.vagas - vcUltimo.colocados)} por preencher.`}
        >
          {anosNacional.map((p) => (
            <line x1={f2(vcX(p.ano))} y1={VC.topo} x2={f2(vcX(p.ano))} y2={VC.A - VC.base} class="vc__grelha" />
          ))}
          <path d={vcBanda} class="vc__banda ponto-vem" style="--dp:.9s" />
