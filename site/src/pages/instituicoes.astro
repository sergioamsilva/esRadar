---
import Base from "../layouts/Base.astro";
import Mapa from "../components/Mapa.astro";
import SerieAnual from "../components/SerieAnual.astro";
import { instituicoes, grupos as lerGrupos, nacional, ligacao, ligacaoInstituicao, formatarInteiro, ANO_INICIO, ANO_CORRENTE } from "../lib/dados";

const todas = instituicoes();

/* Agrupar por instituição-mãe: a Universidade de Coimbra são 9 faculdades
   com códigos próprios no concurso, mas quem procura pensa na universidade. */
const grupos = new Map<string, typeof todas>();
for (const i of todas) {
  const lista = grupos.get(i.grupo) ?? [];
  lista.push(i);
  grupos.set(i.grupo, lista);
}
const agregados = [...grupos.entries()]
  .map(([grupo, membros]) => {
    const vagas = membros.reduce((s, m) => s + m.vagas, 0);
    const colocados = membros.reduce((s, m) => s + m.colocados_f1, 0);
    const sobras = membros.reduce((s, m) => s + m.sobras_f1, 0);
    return {
      grupo,
      membros,
      vagas,
      colocados,
      sobras,
      ocupacao: vagas ? colocados / vagas : 0,
      subsistema: membros[0].subsistema,
    };
  })
  .sort((a, b) => b.vagas - a.vagas);
const maxVagas = Math.max(...agregados.map((a) => a.vagas));

/* ── trinta anos de vagas: subsistemas e instituições-mãe ──────────── */
const nac = nacional();
const anosSub = Object.entries(nac.anos)
  .filter(([, v]) => v.vagas_universitario > 0 && v.vagas_politecnico > 0)
  .map(([ano, v]) => ({ ano: Number(ano), uni: v.vagas_universitario, poli: v.vagas_politecnico }))
  .sort((a, b) => a.ano - b.ano);
const serieUni = anosSub.map((p) => ({ ano: p.ano, valor: p.uni }));
const seriePoli = anosSub.map((p) => ({ ano: p.ano, valor: p.poli }));
const subPrimeiro = anosSub[0];
const subUltimo = anosSub[anosSub.length - 1];
const pctPoli = (p: { uni: number; poli: number }) => Math.round((100 * p.poli) / (p.uni + p.poli));

/* Halteres: vagas de cada instituição-mãe no primeiro e no último ano.
   Só grupos com oferta nos dois anos (as escolas de enfermagem de 1997
   foram integradas noutras instituições e não têm sucessor único). */
const halteres = lerGrupos()
  .map((g) => ({ grupo: g.grupo, antes: g.anos[String(ANO_INICIO)]?.vagas ?? 0, depois: g.anos[String(ANO_CORRENTE)]?.vagas ?? 0 }))
  .filter((g) => g.antes >= 300 && g.depois >= 300)
  .map((g) => ({ ...g, delta: Math.round((100 * (g.depois - g.antes)) / g.antes) }))
  .sort((a, b) => b.depois - a.depois);
const halterMax = Math.max(...halteres.flatMap((g) => [g.antes, g.depois]));
const hx = (v: number) => (100 * v) / halterMax;
const cresceram = halteres.filter((g) => g.delta > 0).length;
---

<Base
  titulo="Instituições"
  descricao="Vagas, colocados e taxa de ocupação da 1ª fase de 2026, instituição a instituição."
>
  <header class="cab">
    <h1>As instituições na 1ª fase de 2026</h1>
    <p class="desc medida">
      Cada ponto do mapa é um estabelecimento — a área são os colocados na 1ª fase de
      2026. Nas barras abaixo, o troço preenchido são os colocados e o vazio as vagas que
      sobraram: a geografia da procura lê-se nas duas vistas, e as sobras concentram-se
      fora dos grandes centros.
    </p>
  </header>

  <section class="card full mapa-card">
    <h3>Onde ficaram os colocados</h3>
    <Mapa instituicoes={todas} alternavel />
  </section>

  <div class="grid">
    <section class="card reveal">
      <h3>Universitário e politécnico, {subUltimo.ano - subPrimeiro.ano} anos de vagas</h3>
      <p class="desc">
        Os politécnicos passaram de {formatarInteiro(subPrimeiro.poli)} vagas em {subPrimeiro.ano} para{" "}
        {formatarInteiro(subUltimo.poli)} em {subUltimo.ano}; as universidades, de {formatarInteiro(subPrimeiro.uni)} para{" "}
        {formatarInteiro(subUltimo.uni)}. A proporção quase não mexeu: {pctPoli(subPrimeiro)}% politécnico então,{" "}
        {pctPoli(subUltimo)}% hoje.
      </p>
      <SerieAnual
        titulo={`Vagas da 1ª fase por subsistema, ${subPrimeiro.ano}–${subUltimo.ano}`}
        unidade="vagas"
        inteiro
        series={[
          { rotulo: "Universitário", pontos: serieUni, cor: "serie-1" },
          { rotulo: "Politécnico", pontos: seriePoli, cor: "serie-2" },
        ]}
      />
      <p class="fonte-lin">
        DGES, resultados do CNA, somados curso a curso. Escolas de saúde e enfermagem
        integradas em universidades contam como politécnico, como no concurso.
      </p>
    </section>

    <section class="card reveal" style="--d:.08s">
      <h3>Quem cresceu, quem encolheu</h3>
      <p class="desc">
        Vagas da 1ª fase de cada instituição-mãe em {ANO_INICIO} e em {ANO_CORRENTE}. Das{" "}
        {halteres.length} com oferta nos dois anos, {cresceram} cresceram. A Universidade
        Técnica de Lisboa conta na Universidade de Lisboa, com quem se fundiu em 2013.
      </p>
      <ol class="halter" aria-label={`Vagas por instituição em ${ANO_INICIO} e ${ANO_CORRENTE}`}>
        <li class="halter__cab" aria-hidden="true">
          <span></span>
          <span class="halter__legenda">
            <span class="halter__chave"><span class="halter__ponto halter__ponto--antes"></span>{ANO_INICIO}</span>
            <span class="halter__chave"><span class="halter__ponto halter__ponto--depois"></span>{ANO_CORRENTE}</span>
          </span>
          <span></span>
        </li>
        {
          halteres.map((g, i) => (
            <li class="reveal" style={`--d:${Math.min(i * 0.03, 0.5)}s`}>
              <span class="halter__nome">{g.grupo.replace("Instituto Politécnico", "IP").replace("Universidade", "U.")}</span>
              <span
                class="halter__pista"
                data-dica={`${g.grupo}: ${formatarInteiro(g.antes)} vagas em ${ANO_INICIO}, ${formatarInteiro(g.depois)} em ${ANO_CORRENTE}`}
              >
                <span
                  class={`halter__liga ${g.depois >= g.antes ? "halter__liga--sobe" : "halter__liga--desce"} cresce`}
                  style={`left:${hx(Math.min(g.antes, g.depois))}%;width:${hx(Math.abs(g.depois - g.antes))}%`}
                />
                <span class="halter__ponto halter__ponto--antes" style={`left:${hx(g.antes)}%`} />
                <span class="halter__ponto halter__ponto--depois" style={`left:${hx(g.depois)}%`} />
              </span>
              <span class={`halter__delta ${g.delta >= 0 ? "halter__delta--sobe" : "halter__delta--desce"}`}>
                {g.delta >= 0 ? "+" : "−"}{Math.abs(g.delta)}%
              </span>
            </li>
          ))
        }
      </ol>
      <p class="fonte-lin">
        Só instituições com pelo menos 300 vagas nos dois anos; os polos e escolas que
        mudaram de código ao longo do tempo estão somados na instituição-mãe.
      </p>
    </section>
  </div>

  <ol class="ranking">
    {
      agregados.map((a, i) => (
        <li class="reveal" style={`--d:${Math.min(i * 0.04, 0.5)}s`}>
          <details>
            <summary>
              <span class="ranking__nome">
                {a.grupo}
                <span class="ranking__meta">
                  {a.subsistema === "politecnico" ? "politécnico" : "universitário"} ·{" "}
                  {formatarInteiro(a.vagas)} vagas · {formatarInteiro(a.colocados)} colocados
                  {a.sobras > 0 && ` · ${formatarInteiro(a.sobras)} sobras`}
                </span>
              </span>
              <span
                class="ranking__barra"
                data-dica={`${a.grupo}: ${Math.round(a.ocupacao * 100)}% das vagas preenchidas — ${formatarInteiro(a.colocados)} colocados em ${formatarInteiro(a.vagas)} vagas`}
                role="img"
                aria-label={`${Math.round(a.ocupacao * 100)} por cento das vagas preenchidas`}
              >
                <span
                  class="ranking__preenchido"
                  style={`width:${(a.vagas / maxVagas) * 100}%`}
                >
                  <span
                    class="cresce"
                    style={`width:${a.ocupacao * 100}%;--d:${Math.min(0.2 + i * 0.04, 0.7)}s`}
                  />
                </span>
              </span>
            </summary>
            <ul class="membros">
              {a.membros
                .sort((x, y) => y.vagas - x.vagas)
                .map((m) => (
                  <li>
                    <a href={ligacaoInstituicao(m)}>{m.nome}</a>
                    <span>
                      {formatarInteiro(m.vagas)} vagas · {formatarInteiro(m.colocados_f1)}{" "}
                      colocados · {m.n_cursos} cursos
                    </span>
                  </li>
                ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  /* ── halteres: vagas antes e depois, por instituição-mãe ──────────── */
  .halter {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .halter li {
    display: grid;
    grid-template-columns: minmax(6.5rem, 11rem) 1fr 3.4rem;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--t-2xs);
  }
  .halter__cab {
    color: var(--muted);
  }
  .halter__legenda {
    display: flex;
    gap: 1rem;
  }
  .halter__chave {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .halter__chave .halter__ponto {
    position: static;
    transform: none;
  }
  .halter__nome {
    color: var(--ink-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .halter__pista {
    position: relative;
    height: 1rem;
    border-bottom: 1px solid var(--grid);
  }
  .halter__liga {
    position: absolute;
    top: 50%;
    height: 4px;
    transform: translateY(-50%);
    border-radius: 2px;
    transform-origin: left center;
  }
  .halter__liga--sobe {
    background: color-mix(in srgb, var(--serie-1) 35%, transparent);
  }
  .halter__liga--desce {
    background: color-mix(in srgb, var(--serie-2) 45%, transparent);
  }
  .halter__ponto {
    position: absolute;
    top: 50%;
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    border: 1.5px solid var(--surface);
  }
  .halter__ponto--antes {
    background: var(--muted);
  }
  .halter__ponto--depois {
    background: var(--serie-1);
  }
  .halter__delta {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .halter__delta--sobe {
    color: var(--serie-1);
  }
  .halter__delta--desce {
    color: var(--serie-2);
  }
  @media (max-width: 480px) {
    .halter li {
      grid-template-columns: 5.6rem 1fr 3rem;
      gap: 0.4rem;
    }
  }

  .cab {
    padding: 26px 0 12px;
  }
  .cab h1 {
    font-size: clamp(24px, 4vw, 34px);
    letter-spacing: -0.02em;
  }
  .mapa-card {
    margin-bottom: 22px;
  }
  .ranking {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
  }
  .ranking summary {
    display: block;
    padding: 10px 2px;
    border-bottom: 1px solid var(--grid);
    cursor: pointer;
  }
  .ranking summary::-webkit-details-marker {
    display: none;
  }
  .ranking summary:hover .ranking__nome {
    color: var(--accent-texto);
  }
  .ranking__nome {
    display: block;
    font-weight: 650;
  }
  .ranking__meta {
    display: block;
    font-size: var(--t-2xs);
    font-weight: 400;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .ranking__barra {
    display: block;
    height: 8px;
    margin-top: 6px;
  }
  .ranking__preenchido {
    display: block;
    height: 100%;
    background: var(--accent-soft);
    border-radius: 4px;
    overflow: hidden;
  }
  .ranking__preenchido > span {
    display: block;
    height: 100%;
    background: var(--serie-1);
    border-radius: 4px 0 0 4px;
  }
  .membros {
    list-style: none;
    margin: 4px 0 10px;
    padding: 0 0 0 14px;
    border-left: 2px solid var(--grid);
  }
  .membros li {
    padding: 5px 0;
    font-size: var(--t-sm);
  }
  .membros span {
    display: block;
    font-size: var(--t-2xs);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
</style>
