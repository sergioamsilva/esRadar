---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { ligacao } from "../lib/dados";

interface Props {
  titulo: string;
  descricao: string;
}
const { titulo, descricao } = Astro.props;
const ano = new Date().getFullYear();
const aqui = Astro.url.pathname;

const SECCOES = [
  { href: ligacao("/"), rotulo: "Panorama" },
  { href: ligacao("/cursos/"), rotulo: "Cursos" },
  { href: ligacao("/comparar/"), rotulo: "Comparar" },
  { href: ligacao("/genero/"), rotulo: "Género" },
  { href: ligacao("/instituicoes/"), rotulo: "Instituições" },
  { href: ligacao("/metodologia/"), rotulo: "Metodologia" },
];
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · esRadar</title>
    <meta name="description" content={descricao} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={`${titulo} · esRadar`} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(aqui, Astro.site).href} />
    <meta property="og:locale" content="pt_PT" />
    <link rel="canonical" href={new URL(aqui, Astro.site).href} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='4' y='14' width='24' height='4' rx='2' fill='%232a78d6'/%3E%3Ccircle cx='22' cy='16' r='5' fill='%23c2571c'/%3E%3C/svg%3E"
    />
    {/* Aplicado antes da primeira pintura, senão o ecrã pisca ao carregar. */}
    <script is:inline>
      (() => {
        const t = localStorage.getItem("esradar-tema");
        if (t) document.documentElement.dataset.theme = t;
        document.documentElement.classList.add("js");
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#conteudo">Saltar para o conteúdo</a>

    <div class="wrap">
      <header class="masthead">
        <a class="brand" href={ligacao("/")}>
          <span class="kicker">
            <span class="dot" aria-hidden="true"></span>esRadar · Observatório do acesso
            ao ensino superior
          </span>
          <p class="marca-titulo">
            As colocações, curso a curso <span class="thin">· 2018–2026</span>
          </p>
        </a>
        <p class="fonte">
          Dados da <a href="https://www.dges.gov.pt/" target="_blank" rel="noopener"
            >Direção-Geral do Ensino Superior</a
          > — resultados do Concurso Nacional de Acesso e guia da candidatura — com o
          histórico recuperado do <a href="https://arquivo.pt/" target="_blank" rel="noopener"
            >Arquivo.pt</a
          >.{" "}
          <span class="naooficial">Não é um serviço oficial da DGES.</span>
        </p>
      </header>

      <nav class="anchors" aria-label="Secções">
        {
          SECCOES.map((s) => (
            <a
              href={s.href}
              aria-current={
                aqui === s.href ||
                (s.href === ligacao("/cursos/") && aqui.includes("/curso/")) ||
                (s.href === ligacao("/instituicoes/") && aqui.includes("/instituicao/"))
                  ? "page"
                  : undefined
              }
            >
              {s.rotulo}
            </a>
          ))
        }
        <button
          class="chip fim"
          type="button"
          data-tema
          aria-label="Alternar entre tema claro e escuro">Tema</button
        >
      </nav>

      <main id="conteudo">
        <slot />
      </main>

      <footer>
        <div class="cols">
          <div class="aviso">
            <h2>O que isto não é</h2>
            <p>
              O esRadar não é um serviço oficial da DGES nem tem ligação ao
              Ministério da Educação. É um trabalho independente que reorganiza
              dados já públicos.
            </p>
          </div>
          <div>
            <h2>A nota de corte não mede qualidade</h2>
            <p>
              A nota do último colocado mede o equilíbrio entre a procura e as
              vagas — <strong>não a qualidade do curso</strong>. Um curso com
              poucas vagas pode ter nota mais alta do que um curso excelente com
              muitas.
            </p>
          </div>
          <div>
            <h2>Origem e código</h2>
            <p>
              Os resultados de 2018 a 2025 foram recuperados das capturas do
              Arquivo.pt, porque a DGES retira as páginas no fim de cada época.
              Código e dados tratados no{" "}
              <a href="https://github.com/sergioamsilva/esRadar" rel="noopener"
                >repositório do projeto</a
              >.
            </p>
          </div>
        </div>
        <p class="rodape-fim">
          esRadar, {ano} · <a href="https://github.com/sergioamsilva/esRadar" rel="noopener"
            >código no GitHub</a
          > · <a href="mailto:radar@cybersec.pt">radar@cybersec.pt</a>
        </p>
      </footer>
    </div>

    <script>
      /* Delegado no documento: sobrevive às navegações do ClientRouter. */
      document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element) || !e.target.closest("[data-tema]")) return;
        const raiz = document.documentElement;
        const escuro =
          raiz.dataset.theme === "dark" ||
          (!raiz.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        raiz.dataset.theme = escuro ? "light" : "dark";
        localStorage.setItem("esradar-tema", raiz.dataset.theme);
      });

      /* ── motor de movimento ──────────────────────────────────────────
         .reveal      entra ao ficar visível (atraso escalonado via --d)
         [data-contar] número que conta até ao valor, com easing
         Corre no primeiro carregamento e após cada navegação. */
      const reduzido = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const contar = (el: HTMLElement) => {
        const alvo = Number(el.dataset.contar ?? "0");
        const casas = Number(el.dataset.casas ?? "0");
        const fmt = (v: number) =>
          v.toLocaleString("pt-PT", { minimumFractionDigits: casas, maximumFractionDigits: casas });
        if (reduzido || alvo === 0) {
          el.textContent = fmt(alvo);
          return;
        }
        const inicio = performance.now();
        const dur = 900;
        const passo = (t: number) => {
          const p = Math.min(1, (t - inicio) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(alvo * e);
          if (p < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      };

      const armar = () => {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              entrada.target.classList.add("on");
              entrada.target
                .querySelectorAll<HTMLElement>("[data-contar]:not(.contado)")
                .forEach((n) => {
                  n.classList.add("contado");
                  contar(n);
                });
              if (entrada.target instanceof HTMLElement && entrada.target.dataset.contar !== undefined && !entrada.target.classList.contains("contado")) {
                entrada.target.classList.add("contado");
                contar(entrada.target);
              }
              observador.unobserve(entrada.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.15 },
        );
        document
          .querySelectorAll(".reveal, [data-contar]")
          .forEach((el) => observador.observe(el));
      };
      armar();
      document.addEventListener("astro:page-load", armar);
    </script>
  </body>
</html>
