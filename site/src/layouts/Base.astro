---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { ligacao } from "../lib/dados";

interface Props {
  titulo: string;
  descricao: string;
  /** Caminho da imagem Open Graph (relativo ao base); por omissão, o cartão do site. */
  ogImagem?: string;
}
const { titulo, descricao, ogImagem = "/og.png" } = Astro.props;
const ano = new Date().getFullYear();
const aqui = Astro.url.pathname;

const SECCOES = [
  { href: ligacao("/"), rotulo: "Panorama" },
  { href: ligacao("/cursos/"), rotulo: "Cursos" },
  { href: ligacao("/comparar/"), rotulo: "Comparar" },
  { href: ligacao("/genero/"), rotulo: "Género" },
  { href: ligacao("/instituicoes/"), rotulo: "Instituições" },
  { href: ligacao("/metodologia/"), rotulo: "Metodologia" },
];
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo} · esRadar</title>
    <meta name="description" content={descricao} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={`${titulo} · esRadar`} />
    <meta property="og:description" content={descricao} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(aqui, Astro.site).href} />
    <meta property="og:image" content={new URL(ligacao(ogImagem), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:site_name" content="esRadar" />
    <meta property="og:locale" content="pt_PT" />
    <link rel="canonical" href={new URL(aqui, Astro.site).href} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='4' y='14' width='24' height='4' rx='2' fill='%232a78d6'/%3E%3Ccircle cx='22' cy='16' r='5' fill='%23c2571c'/%3E%3C/svg%3E"
    />
    {/* Aplicado antes da primeira pintura, senão o ecrã pisca ao carregar. */}
    <script is:inline>
      (() => {
        const t = localStorage.getItem("esradar-tema");
        if (t) document.documentElement.dataset.theme = t;
        document.documentElement.classList.add("js");
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="saltar" href="#conteudo">Saltar para o conteúdo</a>

    <div class="wrap">
      <header class="masthead">
        <a class="brand" href={ligacao("/")}>
          <span class="kicker">
            <span class="dot" aria-hidden="true"></span>esRadar · Observatório do acesso
            ao ensino superior
          </span>
          <p class="marca-titulo">
            As colocações, curso a curso <span class="thin">· 2018–2026</span>
          </p>
        </a>
        <p class="fonte">
          Dados da <a href="https://www.dges.gov.pt/" target="_blank" rel="noopener"
            >Direção-Geral do Ensino Superior</a
          > — resultados do Concurso Nacional de Acesso e guia da candidatura — com o
          histórico recuperado do <a href="https://arquivo.pt/" target="_blank" rel="noopener"
            >Arquivo.pt</a
          >.{" "}
          <span class="naooficial">Não é um serviço oficial da DGES.</span>
        </p>
      </header>

      <nav class="anchors" aria-label="Secções">
        {
          SECCOES.map((s) => (
            <a
              href={s.href}
              aria-current={
                aqui === s.href ||
                (s.href === ligacao("/cursos/") && aqui.includes("/curso/")) ||
                (s.href === ligacao("/instituicoes/") && aqui.includes("/instituicao/"))
                  ? "page"
                  : undefined
              }
            >
              {s.rotulo}
            </a>
          ))
        }
        <button
          class="chip fim js-so"
          type="button"
          hidden
          data-salto-abrir
          aria-label="Procurar curso — tecla de atalho: barra">Procurar /</button
        >
        <button
          class="chip"
          type="button"
          data-tema
          aria-label="Alternar entre tema claro e escuro">Tema</button
        >
      </nav>

      {/* A paleta de pesquisa global. <dialog> nativo: foco preso, Esc fecha.
          O índice dos 1170 cursos vem por fetch na primeira abertura — sem
          JavaScript o botão nem aparece e o índice de cursos é o caminho. */}
      <dialog class="salto" data-salto aria-label="Procurar curso">
        <div class="salto__campo">
          <input
            type="search"
            placeholder="Curso, instituição ou distrito…"
            autocomplete="off"
            data-salto-campo
            aria-label="Procurar curso"
          />
          <button class="salto__fechar" type="button" data-salto-fechar>Esc</button>
        </div>
        <p class="salto__n" data-salto-n aria-live="polite"></p>
        <ul class="salto__resultados" data-salto-resultados></ul>
        <p class="salto__dica">Enter abre o primeiro resultado</p>
      </dialog>

      <main id="conteudo">
        <slot />
      </main>

      <footer>
        <div class="cols">
          <div class="aviso">
            <h2>O que isto não é</h2>
            <p>
              O esRadar não é um serviço oficial da DGES nem tem ligação ao
              Ministério da Educação. É um trabalho independente que reorganiza
              dados já públicos.
            </p>
          </div>
          <div>
            <h2>A nota de corte não mede qualidade</h2>
            <p>
              A nota do último colocado mede o equilíbrio entre a procura e as
              vagas — <strong>não a qualidade do curso</strong>. Um curso com
              poucas vagas pode ter nota mais alta do que um curso excelente com
              muitas.
            </p>
          </div>
          <div>
            <h2>Origem e código</h2>
            <p>
              Os resultados de 2018 a 2025 foram recuperados das capturas do
              Arquivo.pt, porque a DGES retira as páginas no fim de cada época.
              Código e dados tratados no{" "}
              <a href="https://github.com/sergioamsilva/esRadar" rel="noopener"
                >repositório do projeto</a
              >.
            </p>
          </div>
        </div>
        <p class="rodape-fim">
          esRadar, {ano} · <a href="https://github.com/sergioamsilva/esRadar" rel="noopener"
            >código no GitHub</a
          > · <a href="mailto:radar@cybersec.pt">radar@cybersec.pt</a>
        </p>
      </footer>
    </div>

    <script>
      /* Delegado no documento: sobrevive às navegações do ClientRouter. */
      document.addEventListener("click", (e) => {
        if (!(e.target instanceof Element) || !e.target.closest("[data-tema]")) return;
        const raiz = document.documentElement;
        const escuro =
          raiz.dataset.theme === "dark" ||
          (!raiz.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
        raiz.dataset.theme = escuro ? "light" : "dark";
        localStorage.setItem("esradar-tema", raiz.dataset.theme);
      });

      /* ── motor de movimento ──────────────────────────────────────────
         .reveal      entra ao ficar visível (atraso escalonado via --d)
         [data-contar] número que conta até ao valor, com easing
         Corre no primeiro carregamento e após cada navegação. */
      const reduzido = matchMedia("(prefers-reduced-motion: reduce)").matches;

      const contar = (el: HTMLElement) => {
        const alvo = Number(el.dataset.contar ?? "0");
        const casas = Number(el.dataset.casas ?? "0");
        const fmt = (v: number) =>
          v.toLocaleString("pt-PT", { minimumFractionDigits: casas, maximumFractionDigits: casas });
        if (reduzido || alvo === 0) {
          el.textContent = fmt(alvo);
          return;
        }
        const inicio = performance.now();
        const dur = 900;
        const passo = (t: number) => {
          const p = Math.min(1, (t - inicio) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          el.textContent = fmt(alvo * e);
          if (p < 1) requestAnimationFrame(passo);
        };
        requestAnimationFrame(passo);
      };

      const armar = () => {
        const observador = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              entrada.target.classList.add("on");
              entrada.target
                .querySelectorAll<HTMLElement>("[data-contar]:not(.contado)")
                .forEach((n) => {
                  n.classList.add("contado");
                  contar(n);
                });
              if (entrada.target instanceof HTMLElement && entrada.target.dataset.contar !== undefined && !entrada.target.classList.contains("contado")) {
                entrada.target.classList.add("contado");
                contar(entrada.target);
              }
              observador.unobserve(entrada.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.15 },
        );
        document
          .querySelectorAll(".reveal, [data-contar]")
          .forEach((el) => observador.observe(el));
      };
      armar();
      document.addEventListener("astro:page-load", armar);

      /* ── a paleta de pesquisa global ─────────────────────────────────
         Índice por fetch na primeira abertura; atalho «/». */
      type ItemPesquisa = { t: "i" | "c"; u: string; c: string; i: string; g: string; d: string | null; n: number | null };
      let indicePesquisa: (ItemPesquisa & { b: string })[] | null = null;
      const semAcentos = (s: string) => s.normalize("NFD").replace(/\p{Diacritic}/gu, "");
      const basePortal = document.querySelector<HTMLAnchorElement>("nav.anchors a")!.pathname.replace(/\/$/, "");

      const carregarIndice = async () => {
        if (indicePesquisa) return indicePesquisa;
        const resp = await fetch(`${basePortal}/dados/pesquisa.json`);
        const dados: ItemPesquisa[] = await resp.json();
        indicePesquisa = dados.map((d) => ({
          ...d,
          b: semAcentos(`${d.c} ${d.i} ${d.g} ${d.d ?? ""}`.toLowerCase()),
        }));
        return indicePesquisa;
      };

      const armarSalto = () => {
        const abrir = document.querySelector<HTMLButtonElement>("[data-salto-abrir]");
        const dialogo = document.querySelector<HTMLDialogElement>("[data-salto]");
        const campo = document.querySelector<HTMLInputElement>("[data-salto-campo]");
        const resultados = document.querySelector<HTMLUListElement>("[data-salto-resultados]");
        const contagem = document.querySelector<HTMLElement>("[data-salto-n]");
        if (!abrir || !dialogo || !campo || !resultados || abrir.dataset.armado) return;
        abrir.dataset.armado = "1";
        abrir.hidden = false;

        const desenhar = async (q: string) => {
          const lista = await carregarIndice();
          const termos = semAcentos(q.trim().toLowerCase()).split(/\s+/).filter(Boolean);
          const todos = termos.length
            ? lista.filter((d) => termos.every((t) => d.b.includes(t)))
            : [];
          /* Instituições primeiro (no máximo 3), depois cursos. */
          const achados = [
            ...todos.filter((d) => d.t === "i").slice(0, 3),
            ...todos.filter((d) => d.t === "c"),
          ].slice(0, 9);
          resultados.innerHTML = achados
            .map(
              (d) =>
                `<li><a href="${d.u}">${d.t === "i" ? '<em class="salto__tipo">instituição</em>' : ""}<b>${d.c}</b><span>${d.i}${d.d ? ` · ${d.d}` : ""}${d.n != null ? ` · corte ${d.n.toLocaleString("pt-PT", { minimumFractionDigits: 1 })}` : ""}</span></a></li>`,
            )
            .join("");
          if (contagem)
            contagem.textContent = termos.length
              ? `${todos.filter((d) => d.t === "c").length.toLocaleString("pt-PT")} cursos${todos.some((d) => d.t === "i") ? ` · ${todos.filter((d) => d.t === "i").length} instituições` : ""}`
              : "";
        };

        const mostrar = () => {
          dialogo.showModal();
          campo.value = "";
          desenhar("");
          campo.focus();
        };
        abrir.addEventListener("click", mostrar);
        campo.addEventListener("input", () => desenhar(campo.value));
        campo.addEventListener("keydown", (e) => {
          if (e.key === "Enter") {
            const primeiro = resultados.querySelector("a");
            if (primeiro) {
              e.preventDefault();
              (primeiro as HTMLAnchorElement).click();
              dialogo.close();
            }
          }
        });
        document.querySelector("[data-salto-fechar]")?.addEventListener("click", () => dialogo.close());
        dialogo.addEventListener("click", (e) => {
          if (e.target === dialogo) dialogo.close();
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "/" && !dialogo.open && !(e.target instanceof HTMLInputElement) && !(e.target instanceof HTMLTextAreaElement)) {
            e.preventDefault();
            mostrar();
          }
        });
        document.addEventListener("astro:page-load", () => dialogo.open && dialogo.close());
      };
      armarSalto();
      document.addEventListener("astro:page-load", armarSalto);

      /* ── motor de hover dos gráficos ─────────────────────────────────
         - svg[data-hover-serie]: crosshair no ano mais próximo, pontos em
           foco e tooltip com os valores de todas as séries (o texto vem
           dos <title> que os pontos já têm — zero duplicação de dados);
         - [data-dica]: tooltip instantâneo em barras/colunas.
         Tudo delegado no documento — sobrevive ao ClientRouter. */
      let dicaEl: HTMLDivElement | null = null;
      const dica = () => {
        if (!dicaEl || !document.body.contains(dicaEl)) {
          dicaEl = document.createElement("div");
          dicaEl.className = "dica-flutuante";
          dicaEl.setAttribute("role", "status");
          document.body.appendChild(dicaEl);
        }
        return dicaEl;
      };
      const mostrarDica = (texto: string, e: MouseEvent) => {
        const el = dica();
        el.textContent = texto;
        el.classList.add("on");
        const larg = el.offsetWidth;
        const x = Math.min(Math.max(8, e.clientX + 14), window.innerWidth - larg - 8);
        const y = e.clientY + 16 + el.offsetHeight > window.innerHeight ? e.clientY - el.offsetHeight - 12 : e.clientY + 16;
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
      };
      const esconderDica = () => dicaEl?.classList.remove("on");

      let svgAtivo: SVGSVGElement | null = null;
      const limparSerie = () => {
        if (!svgAtivo) return;
        svgAtivo.querySelector(".crosshair-linha")?.remove();
        svgAtivo.querySelectorAll("circle.em-foco").forEach((c) => c.classList.remove("em-foco"));
        svgAtivo = null;
      };

      document.addEventListener("mousemove", (e) => {
        const alvo = e.target instanceof Element ? e.target : null;
        const svg = alvo?.closest?.("svg[data-hover-serie]") as SVGSVGElement | null;
        if (svg) {
          if (svgAtivo && svgAtivo !== svg) limparSerie();
          svgAtivo = svg;
          const vb = svg.viewBox.baseVal;
          const r = svg.getBoundingClientRect();
          const fx = ((e.clientX - r.left) / r.width) * vb.width;
          const circulos = [...svg.querySelectorAll<SVGCircleElement>("circle[data-ano]")];
          if (!circulos.length) return;
          let melhorAno = circulos[0].dataset.ano!;
          let melhorDist = Infinity;
          for (const c of circulos) {
            const d = Math.abs(Number(c.getAttribute("cx")) - fx);
            if (d < melhorDist) {
              melhorDist = d;
              melhorAno = c.dataset.ano!;
            }
          }
          const doAno = circulos.filter((c) => c.dataset.ano === melhorAno);
          circulos.forEach((c) => c.classList.toggle("em-foco", c.dataset.ano === melhorAno));
          let linha = svg.querySelector<SVGLineElement>(".crosshair-linha");
          if (!linha) {
            linha = document.createElementNS("http://www.w3.org/2000/svg", "line");
            linha.setAttribute("class", "crosshair-linha");
            svg.insertBefore(linha, svg.firstChild?.nextSibling ?? null);
          }
          const cx = doAno[0].getAttribute("cx")!;
          linha.setAttribute("x1", cx);
          linha.setAttribute("x2", cx);
          linha.setAttribute("y1", "0");
          linha.setAttribute("y2", String(vb.height));
          const texto = doAno
            .map((c) => c.querySelector("title")?.textContent?.trim())
            .filter(Boolean)
            .join("\n");
          if (texto) mostrarDica(texto, e);
          return;
        }
        limparSerie();
        const comDica = alvo?.closest?.("[data-dica]") as HTMLElement | null;
        if (comDica?.dataset.dica) mostrarDica(comDica.dataset.dica, e);
        else esconderDica();
      });
      document.addEventListener("mouseleave", () => {
        limparSerie();
        esconderDica();
      });
      document.addEventListener("astro:page-load", () => {
        limparSerie();
        esconderDica();
      });
    </script>
  </body>
</html>
